#!/usr/bin/env bash
set -eo pipefail

REPO_DIR="${REPO_CHECK_DIR:-$(pwd)}"
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/repoz/config"

# Hardened git wrapper. Never prompts for credentials (a single passphrase
# prompt would hang the whole run), never takes optional locks (polling many
# repos must not fight editors or GUI clients for index.lock), and fails
# fast on unreachable SSH hosts instead of waiting on TCP timeouts.
run_git() {
        GIT_TERMINAL_PROMPT=0 GIT_ASKPASS=true \
                GIT_SSH_COMMAND='ssh -oBatchMode=yes -oConnectTimeout=5' \
                git --no-optional-locks "$@"
}

# Max simultaneous background fetches (SSH servers throttle beyond this).
FETCH_CAP=8

# --- Defaults (overridden by config file) ---
WORK_START=9
WORK_END=18
REPO_LIMIT=50
EXTRA_DIRS=()
SHOW_GLYPHS=true
# Nerd Font glyphs (bytes, not \u — macOS bash 3.2 has no \u in $'…').
# Defaults applied after config load so a config value wins.
GLYPH_ORG=""
GLYPH_PRIVATE=""
GLYPH_PUBLIC=""
TERM_W=$(stty size </dev/tty 2>/dev/null | awk '{print $2}') || true
: "${TERM_W:=${COLUMNS:-0}}"
((TERM_W < 40)) && TERM_W=$(tput cols 2>/dev/null || echo 80)
((TERM_W < 40)) && TERM_W=80

# --- Load config ---
if [ -f "$CONFIG_FILE" ]; then
        while IFS='=' read -r key val; do
                case "$key" in
                \#* | "") continue ;;
                WORK_START) WORK_START=$((10#$val)) ;;
                WORK_END) WORK_END=$((10#$val)) ;;
                REPO_LIMIT) REPO_LIMIT=$((10#$val)) ;;
                REPO_CHECK_DIR) [ -z "${REPO_CHECK_DIR:-}" ] && REPO_DIR="$val" ;;
                REPOZ_SRC) [ -z "${REPOZ_SRC:-}" ] && REPOZ_SRC="$val" ;;
                EXTRA_DIRS) IFS=':' read -ra EXTRA_DIRS <<<"$val" ;;
                SHOW_GLYPHS) SHOW_GLYPHS="$val" ;;
                GLYPH_ORG) GLYPH_ORG="$val" ;;
                GLYPH_PRIVATE) GLYPH_PRIVATE="$val" ;;
                GLYPH_PUBLIC) GLYPH_PUBLIC="$val" ;;

                esac
        done <"$CONFIG_FILE"
fi

# Where 'repoz --update' reads the source from (env > config > default clone).
REPOZ_SRC="${REPOZ_SRC:-$HOME/Repos/repoz}"

# Build validated scan dirs (REPO_DIR + existing EXTRA_DIRS)
SCAN_DIRS=("$REPO_DIR")
for _d in "${EXTRA_DIRS[@]}"; do
        [ -d "$_d" ] && SCAN_DIRS+=("$_d")
done

# If cwd sits inside a git repo, include that repo's toplevel so the
# dirty-scan pass catches it when running from a subdirectory.
_toplevel=$(run_git -C "$REPO_DIR" rev-parse --show-toplevel 2>/dev/null) || true
[ -n "$_toplevel" ] && [ "$_toplevel" != "$REPO_DIR" ] && SCAN_DIRS+=("$_toplevel")

# Catppuccin Mocha palette (printf for bash 3.2 compat)
PEACH=$(printf '\033[38;2;250;179;135m')      # behind / warning
GREEN=$(printf '\033[38;2;166;227;161m')      # ahead / synced
YELLOW=$(printf '\033[38;2;249;226;175m')     # uncommitted
SAPPHIRE=$(printf '\033[38;2;116;199;236m')   # repo names
LAVENDER=$(printf '\033[38;2;180;190;254m')   # header
MAUVE=$(printf '\033[38;2;203;166;247m')      # section labels
HASH_COLOR=$(printf '\033[38;2;140;155;180m') # commit hashes (muted blue-gray)
DIFF_ADD=$(printf '\033[38;2;134;194;134m')   # diff +N (mellow green)
DIFF_DEL=$(printf '\033[38;2;210;140;140m')   # diff -N (mellow red)
OVERLAY=$(printf '\033[38;2;127;132;156m')    # paths, subtle text
SURFACE=$(printf '\033[38;2;69;71;90m')       # dots, dividers
RED=$(printf '\033[38;2;243;139;168m')        # not cloned / alert
BOLD=$(printf '\033[1m')
RESET=$(printf '\033[0m')

# --- Glyph defaults (Font Awesome, as UTF-8 bytes) + semantic colors ---
#   org -> building (U+F1AD)  private -> lock (U+F023)  public -> globe (U+F0AC)
: "${GLYPH_ORG:=$(printf '\357\206\255')}"
: "${GLYPH_PRIVATE:=$(printf '\357\200\243')}"
: "${GLYPH_PUBLIC:=$(printf '\357\202\254')}"
GLYPH_ORG_COLOR="$MAUVE"     # org
GLYPH_PRIVATE_COLOR="$PEACH" # personal, private
GLYPH_PUBLIC_COLOR="$GREEN"  # personal, public

# --- Status symbols for the countable states (plain Unicode, no Nerd Font) ---
#   behind -> down arrow (U+2193)  ahead -> up arrow (U+2191)
#   stashed -> flag (U+2691).      uncommitted is a plain ASCII bang.
# Words are kept for the categorical states (synced, not cloned, and the
# in-progress operations), and the summary footer still spells all four out,
# so it doubles as the legend.
SYM_BEHIND=$(printf '\342\206\223')
SYM_AHEAD=$(printf '\342\206\221')
SYM_DIRTY='!'
SYM_STASH=$(printf '\342\232\221')
# name -> "<type>\t<isPrivate>" lookup, populated after the GitHub scan.
# Empty in dirty/target modes (no listing built), so glyphs are simply omitted.
meta_lookup=""

# --- Slot labels from config ---
slot_label_work="Work ($(printf '%02d' $WORK_START)-$(printf '%02d' $WORK_END))"
slot_label_evening="Evening ($(printf '%02d' $WORK_END)-00)"

usage() {
        cat <<'EOF'
Usage: repoz [options]

Checks GitHub for recently pushed repos and compares with local state.
Only checks repos found under the current directory (or REPO_CHECK_DIR).

Modes (pick one):
  (default)       Show activity since the previous time slot
  --since DATE    Show all activity since DATE (e.g. 2026-03-15)
  --since yesterday  Relative: yesterday
  --since 3d      Relative: 3 days ago
  --since 1w      Relative: 1 week ago
  -t, --today     Show all activity since midnight
  -a, --all       Show all divergence (no time filter)
  -d, --dirty     Local only: show uncommitted/untracked/unpushed (no GitHub)
  /owner/repo     Target one repo, show only its status (read-only). A single
                  segment (/repo) resolves against your GitHub user.

Options:
  --author NAME   Filter displayed commits by author (partial match)
  --before DATE   Only show repos pushed before DATE (same formats as --since)
  -s, --stat      Show diff stats per commit (+lines/-lines)
  -r, --releases  Show release status per repo (tag, commits since tag)
  -p, --prs       Also show open pull requests for each repo
  --no-glyphs     Hide the org/private/public repo-type glyphs
  --update        Reinstall repoz from your local clone (no pull)
  --update --pull git pull --ff-only the clone first, then reinstall
  -h, --help      Show this help

Status symbols (each keeps its own color, the same one the summary uses):
  2↓  commits behind the remote          peach
  1↑  commits not pushed anywhere        peach
  3!  uncommitted or untracked files     yellow
  1⚑  stashes waiting                    mauve
  2PR open pull requests (with -p)       mauve
States that are not counts stay words: synced, not cloned, and the
in-progress operations (merging, rebasing, cherry-picking, reverting,
bisecting) which turn the whole row red.

Time slots: Work (09-18), Evening (18-00). Default mode shows activity
since the previous slot boundary, so you see what changed while away.
Config: ~/.config/repoz/config (or REPO_CHECK_DIR env var).
Set EXTRA_DIRS=/path/one:/path/two to scan additional directories.
Set REPOZ_SRC=/path/to/clone if --update can't find your repoz clone.
EOF
}

# --- Parse args ---
MODE="auto"
SINCE_ARG=""
BEFORE_ARG=""
AUTHOR_FILTER=""
SHOW_PRS=false
SHOW_STAT=false
SHOW_RELEASES=false
TARGET_REPO=""
UPDATE_PULL=false

while [ $# -gt 0 ]; do
        case "$1" in
        --since)
                MODE="since"
                SINCE_ARG="$2"
                shift 2
                ;;
        --before)
                BEFORE_ARG="$2"
                shift 2
                ;;
        --author)
                AUTHOR_FILTER="$2"
                shift 2
                ;;
        -t | --today)
                MODE="today"
                shift
                ;;
        -a | --all)
                MODE="all"
                shift
                ;;
        -d | --dirty)
                MODE="dirty"
                shift
                ;;
        -s | --stat)
                SHOW_STAT=true
                shift
                ;;
        -r | --releases)
                SHOW_RELEASES=true
                shift
                ;;
        -p | --prs)
                SHOW_PRS=true
                shift
                ;;
        --no-glyphs)
                SHOW_GLYPHS=false
                shift
                ;;
        --update)
                MODE="update"
                shift
                ;;
        --pull)
                UPDATE_PULL=true
                shift
                ;;
        -h | --help)
                usage
                exit 0
                ;;
        /*)
                TARGET_REPO="$1"
                shift
                ;;
        *)
                echo "Unknown: $1"
                usage
                exit 1
                ;;
        esac
done

# --- Self-update: reinstall this command from the local clone (no pull unless --pull) ---
if [ "$MODE" = "update" ]; then
        src_file="$REPOZ_SRC/repoz"
        if [ ! -f "$src_file" ]; then
                echo "  repoz source not found at ${src_file}"
                echo "  Set REPOZ_SRC (env or ~/.config/repoz/config) to your repoz clone."
                exit 1
        fi

        if $UPDATE_PULL; then
                echo "  Pulling ${REPOZ_SRC} (fast-forward only)…"
                if ! git -C "$REPOZ_SRC" pull --ff-only; then
                        echo "  Pull could not fast-forward — resolve it manually, then rerun. Install skipped."
                        exit 1
                fi
        fi

        # Resolve the path of the running script, following any symlinks (bash 3.2 safe).
        self_src="${BASH_SOURCE[0]:-$0}"
        while [ -h "$self_src" ]; do
                self_dir=$(cd -P "$(dirname "$self_src")" && pwd)
                self_src=$(readlink "$self_src")
                case "$self_src" in /*) ;; *) self_src="$self_dir/$self_src" ;; esac
        done
        target="$(cd -P "$(dirname "$self_src")" && pwd)/$(basename "$self_src")"

        if [ "$src_file" -ef "$target" ]; then
                echo "  Running the source copy directly (${target}); nothing to install."
                exit 0
        fi

        if cp "$src_file" "$target" && chmod +x "$target"; then
                echo "  Updated ${target}"
                echo "  from    ${src_file}"
        else
                echo "  Failed to write ${target} (check permissions)."
                exit 1
        fi
        exit 0
fi

# --- Resolve relative dates for --since ---
if [ "$MODE" = "since" ] && [ -n "$SINCE_ARG" ]; then
        case "$SINCE_ARG" in
        yesterday)
                if SINCE_ARG=$(date -v-1d +%Y-%m-%d 2>/dev/null); then
                        :
                else SINCE_ARG=$(date -d "yesterday" +%Y-%m-%d); fi
                ;;
        *d)
                days="${SINCE_ARG%d}"
                if SINCE_ARG=$(date -v-${days}d +%Y-%m-%d 2>/dev/null); then
                        :
                else SINCE_ARG=$(date -d "${days} days ago" +%Y-%m-%d); fi
                ;;
        *w)
                weeks="${SINCE_ARG%w}"
                days=$((weeks * 7))
                if SINCE_ARG=$(date -v-${days}d +%Y-%m-%d 2>/dev/null); then
                        :
                else SINCE_ARG=$(date -d "${days} days ago" +%Y-%m-%d); fi
                ;;
        esac
fi

# --- Resolve relative dates for --before ---
if [ -n "$BEFORE_ARG" ]; then
        case "$BEFORE_ARG" in
        yesterday)
                if BEFORE_ARG=$(date -v-1d +%Y-%m-%d 2>/dev/null); then
                        :
                else BEFORE_ARG=$(date -d "yesterday" +%Y-%m-%d); fi
                ;;
        *d)
                days="${BEFORE_ARG%d}"
                if BEFORE_ARG=$(date -v-${days}d +%Y-%m-%d 2>/dev/null); then
                        :
                else BEFORE_ARG=$(date -d "${days} days ago" +%Y-%m-%d); fi
                ;;
        *w)
                weeks="${BEFORE_ARG%w}"
                days=$((weeks * 7))
                if BEFORE_ARG=$(date -v-${days}d +%Y-%m-%d 2>/dev/null); then
                        :
                else BEFORE_ARG=$(date -d "${days} days ago" +%Y-%m-%d); fi
                ;;
        esac
fi

DIV_W=$((TERM_W - 4))
DIV="${SURFACE}$(printf '%*s' "$DIV_W" '' | tr ' ' '─')${RESET}"

section_div() {
        local label="$1"
        local prefix="── ${label} "
        local remain=$((DIV_W - ${#prefix}))
        printf '  %s── %s%s %s%s%s\n' \
                "$SURFACE" "$MAUVE" "$label" "$SURFACE" "$(printf '%*s' "$remain" '' | tr ' ' '─')" "$RESET"
}

W=$((DIV_W - 4))

# Emit the colored glyph for a repo (org / private / public), or nothing when
# glyphs are off or the repo has no GitHub metadata (e.g. local-only repos).
get_repo_glyph() {
        $SHOW_GLYPHS || return
        [ -z "$meta_lookup" ] && return
        local line
        line=$(printf '%s\n' "$meta_lookup" | awk -F'\t' -v n="$1" '$1 == n { print; exit }')
        [ -z "$line" ] && return
        local otype priv
        otype=$(printf '%s' "$line" | cut -f2)
        priv=$(printf '%s' "$line" | cut -f3)
        if [ "$otype" = "Organization" ]; then
                printf '%s%s%s' "$GLYPH_ORG_COLOR" "$GLYPH_ORG" "$RESET"
        elif [ "$priv" = "true" ]; then
                printf '%s%s%s' "$GLYPH_PRIVATE_COLOR" "$GLYPH_PRIVATE" "$RESET"
        else
                printf '%s%s%s' "$GLYPH_PUBLIC_COLOR" "$GLYPH_PUBLIC" "$RESET"
        fi
}

print_row() {
        local name="$1" status="$2" color="$3" path="${4:-}"
        local glyph glyph_w=0
        glyph=$(get_repo_glyph "$name")
        $SHOW_GLYPHS && glyph_w=2 # 1 cell for the glyph + 1 trailing space
        local label_len=${#name}
        [ -n "$path" ] && label_len=$((${#name} + 1 + ${#path}))
        local pad=$((W - glyph_w - label_len - ${#status}))
        ((pad < 3)) && pad=3
        local dots=$(printf '%*s' "$pad" '' | tr ' ' '·')
        printf "    "
        if $SHOW_GLYPHS; then
                if [ -n "$glyph" ]; then
                        printf "%s " "$glyph"
                else
                        printf "  "
                fi
        fi
        printf "${SAPPHIRE}%s${RESET}" "$name"
        [ -n "$path" ] && printf " ${OVERLAY}%s${RESET}" "$path"
        # Width came from the plain status above; the painted copy is the same
        # text with per-token colors, so the column stays aligned.
        printf " ${SURFACE}%s${RESET} %s${RESET}\n" \
                "$dots" "$(colorize_status "$status" "$color")"
}

# Resolve a repo's real git dir. In linked worktrees .git is a file holding
# "gitdir: <path>"; plain repos have a .git directory.
resolve_git_dir() {
        local g="$1/.git"
        if [ -f "$g" ]; then
                local p
                p=$(sed -n 's/^gitdir: //p' "$g" 2>/dev/null)
                case "$p" in
                /*) g="$p" ;;
                ?*) g="$1/$p" ;;
                *) return 1 ;;
                esac
        fi
        [ -d "$g" ] && printf '%s\n' "$g"
}

# Name the operation a repo is in the middle of, if any. Marker files are
# read directly instead of spawning git; this is what git itself checks.
repo_operation() {
        local g
        g=$(resolve_git_dir "$1") || return 0
        if [ -f "$g/MERGE_HEAD" ]; then echo "merging"
        elif [ -d "$g/rebase-merge" ] || [ -d "$g/rebase-apply" ]; then echo "rebasing"
        elif [ -f "$g/CHERRY_PICK_HEAD" ]; then echo "cherry-picking"
        elif [ -f "$g/REVERT_HEAD" ]; then echo "reverting"
        elif [ -f "$g/BISECT_LOG" ]; then echo "bisecting"
        fi
}

# Stash count from the stash reflog, no subprocess. Linked worktrees keep
# shared state in the common dir, so follow the commondir pointer first
# (drydock gets this wrong and reports 0 for worktrees).
stash_count() {
        local g c
        g=$(resolve_git_dir "$1") || { echo 0; return; }
        if [ -f "$g/commondir" ]; then
                c=$(cat "$g/commondir" 2>/dev/null)
                case "$c" in
                /*) g="$c" ;;
                ?*) g="$g/$c" ;;
                esac
        fi
        if [ -f "$g/logs/refs/stash" ]; then
                wc -l <"$g/logs/refs/stash" | tr -d ' '
        else
                echo 0
        fi
}

# Paint each status token in its own color, so a compound status reads as
# distinct facts rather than one blob: in "2! 1⚑" the bang is yellow and the
# flag is mauve, matching the colors the summary footer uses for the same
# counts. Tokens that are not symbol groups (an operation word, "synced",
# "not cloned") fall back to the row color the caller chose.
colorize_status() {
        local plain="$1" fallback="$2" out="" tok c
        for tok in $plain; do
                case "$tok" in
                *"$SYM_BEHIND" | *"$SYM_AHEAD") c="$PEACH" ;;
                *"$SYM_STASH") c="$MAUVE" ;;
                *PR) c="$MAUVE" ;;
                *!) c="$YELLOW" ;;
                *) c="$fallback" ;;
                esac
                [ -n "$out" ] && out="${out} "
                out="${out}${c}${tok}${RESET}"
        done
        printf '%s' "$out"
}

# Join the countable states into one compact symbol group, e.g. "2↓ 1↑ 3!".
# Zero counts are omitted entirely; an all-zero repo yields an empty string,
# which callers read as "nothing to report".
status_symbols() {
        local behind="$1" ahead="$2" dirty="$3" stashes="$4" out=""
        if [ "$behind" -gt 0 ]; then
                out="${behind}${SYM_BEHIND}"
        fi
        if [ "$ahead" -gt 0 ]; then
                [ -n "$out" ] && out="${out} "
                out="${out}${ahead}${SYM_AHEAD}"
        fi
        if [ "$dirty" -gt 0 ]; then
                [ -n "$out" ] && out="${out} "
                out="${out}${dirty}${SYM_DIRTY}"
        fi
        if [ "$stashes" -gt 0 ]; then
                [ -n "$out" ] && out="${out} "
                out="${out}${stashes}${SYM_STASH}"
        fi
        printf '%s' "$out"
}

# Prefix a symbol group with an in-progress operation word, when there is one:
# "rebasing, 1!". Either part may be empty.
status_with_op() {
        local op="$1" sym="$2"
        if [ -n "$op" ] && [ -n "$sym" ]; then
                printf '%s, %s' "$op" "$sym"
        else
                printf '%s%s' "$op" "$sym"
        fi
}

# Release status relative to the newest reachable version-ish tag. The
# --match glob skips marker tags like "latest"; --no-merges keeps git-flow
# back-merges from counting as unreleased work (borrowed from drydock).
release_status() {
        local p="$1" tag n
        tag=$(run_git -C "$p" describe --tags --abbrev=0 --match '*[0-9]*' 2>/dev/null) || {
                echo "unreleased"
                return
        }
        n=$(run_git -C "$p" rev-list --count --no-merges "${tag}..HEAD" 2>/dev/null) || n=0
        if [ "$n" -gt 0 ]; then
                echo "${n} since ${tag}"
        else
                echo "released ${tag}"
        fi
}

# One pruned scan of HOME for git repos. Pruning by NAME stops descent into
# dependency and build trees entirely (the old -not -path filters still
# traversed them). Tradeoff: a repo literally named e.g. "build" or
# "target" under HOME is skipped; acceptable for the speed win.
scan_home_git_dirs() {
        find "$HOME" -maxdepth 4 \( \
                -name Library -o -name .Trash -o -name .cache -o \
                -name node_modules -o -name vendor -o -name target -o \
                -name .venv -o -name venv -o -name dist -o -name build -o \
                -name Pods -o -name DerivedData -o -name .terraform -o \
                -name .gradle \) -prune -o \
                -type d -name .git -print 2>/dev/null
}

# --- Dirty mode: local only, no GitHub ---
if [ "$MODE" = "dirty" ]; then
        echo ""
        echo "  ${LAVENDER}${BOLD}repoz${RESET} ${OVERLAY}— local changes${RESET}"
        echo "  ${DIV}"
        echo ""

        count_unpushed() {
                local repo_path="$1" total=0
                while IFS= read -r branch; do
                        [ -z "$branch" ] && continue
                        run_git -C "$repo_path" rev-parse --abbrev-ref \
                                "${branch}@{upstream}" >/dev/null 2>&1 || continue
                        local a
                        # Commits not reachable from ANY remote branch, not just this
                        # branch's own upstream — a branch merged elsewhere (e.g. a
                        # leftover worktree branch already landed on main) shouldn't
                        # count as "ahead" just because its own upstream is stale.
                        a=$(run_git -C "$repo_path" rev-list --count \
                                "$branch" --not --remotes 2>/dev/null || echo 0)
                        total=$((total + a))
                done < <(run_git -C "$repo_path" for-each-ref \
                        --format='%(refname:short)' refs/heads/ 2>/dev/null)
                echo "$total"
        }

        dirty_count=0
        while IFS= read -r gitdir; do
                repo_path="${gitdir%/.git}"
                name=$(basename "$repo_path")
                display="~${repo_path#$HOME}"

                changed=$(run_git -C "$repo_path" status --porcelain 2>/dev/null |
                        wc -l | tr -d ' ')
                local_ahead=$(count_unpushed "$repo_path")
                op=$(repo_operation "$repo_path")
                stashes=$(stash_count "$repo_path")

                [ "$changed" -eq 0 ] && [ "$local_ahead" -eq 0 ] && [ -z "$op" ] && [ "$stashes" -eq 0 ] && continue

                status=$(status_with_op "$op" \
                        "$(status_symbols 0 "$local_ahead" "$changed" "$stashes")")
                color="$PEACH"
                [ "$changed" -gt 0 ] && color="$YELLOW"
                [ "$status" = "${stashes}${SYM_STASH}" ] && color="$MAUVE"
                [ -n "$op" ] && color="$RED"
                print_row "$name" "$status" "$color" "$display"
                dirty_count=$((dirty_count + 1))

        done < <(find "${SCAN_DIRS[@]}" -maxdepth 4 -name ".git" -type d 2>/dev/null | sort -u)

        echo ""
        echo "  ${DIV}"
        if [ "$dirty_count" -eq 0 ]; then
                echo "  ${GREEN}All clean.${RESET}"
        else
                echo "  ${YELLOW}${dirty_count} dirty${RESET}"
        fi
        echo ""
        exit 0
fi

# --- Targeted single-repo mode: 'repoz /owner/repo' or 'repoz /repo' ---
# A leading '/' means "just this one repo". Two segments are owner/repo as given;
# a single segment resolves against the authenticated GitHub user. Read-only: it
# reports status, and flags 'not cloned' in the alert color if it's not on disk.
if [ -n "$TARGET_REPO" ]; then
        tr_spec="${TARGET_REPO#/}"
        if [[ "$tr_spec" == */* ]]; then
                t_owner="${tr_spec%%/*}"
                t_name="${tr_spec##*/}"
        else
                t_owner=$(gh api user --jq .login 2>/dev/null)
                [ -z "$t_owner" ] && t_owner="?"
                t_name="$tr_spec"
        fi
        t_full="${t_owner}/${t_name}"

        echo ""
        echo "  ${LAVENDER}${BOLD}repoz${RESET} ${OVERLAY}— ${t_full}${RESET}"
        echo "  ${DIV}"
        echo ""

        # Locate a local clone by directory name (case-insensitive, dotted variant too)
        t_local=""
        t_lc=$(echo "$t_name" | tr '[:upper:]' '[:lower:]')
        while IFS= read -r gitdir; do
                [ -z "$gitdir" ] && continue
                d="${gitdir%/.git}"
                b=$(basename "$d" | tr '[:upper:]' '[:lower:]')
                if [ "$b" = "$t_lc" ] || [ "$b" = ".$t_lc" ]; then
                        t_local="$d"
                        break
                fi
        done < <(scan_home_git_dirs)

        if [ -n "$t_local" ]; then
                run_git -C "$t_local" fetch --quiet --prune 2>/dev/null || true
                t_display="~${t_local#$HOME}"
                t_changed=$(run_git -C "$t_local" status --porcelain 2>/dev/null | wc -l | tr -d ' ')
                t_op=$(repo_operation "$t_local")
                t_behind=0
                t_ahead=0
                while IFS= read -r branch; do
                        [ -z "$branch" ] && continue
                        up=$(run_git -C "$t_local" rev-parse --abbrev-ref "${branch}@{upstream}" 2>/dev/null) || continue
                        bb=$(run_git -C "$t_local" rev-list --count "${branch}..${up}" 2>/dev/null || echo 0)
                        aa=$(run_git -C "$t_local" rev-list --count "${branch}" --not --remotes 2>/dev/null || echo 0)
                        t_behind=$((t_behind + bb))
                        t_ahead=$((t_ahead + aa))
                done < <(run_git -C "$t_local" for-each-ref --format='%(refname:short)' refs/heads/ 2>/dev/null)

                t_color="$GREEN"
                t_stashes=$(stash_count "$t_local")
                t_status=$(status_with_op "$t_op" \
                        "$(status_symbols "$t_behind" "$t_ahead" "$t_changed" "$t_stashes")")
                if [ -z "$t_status" ]; then t_status="synced"; else
                        t_color="$PEACH"
                        ((t_changed > 0)) && t_color="$YELLOW"
                        [ "$t_status" = "${t_stashes}${SYM_STASH}" ] && t_color="$MAUVE"
                        [ -n "$t_op" ] && t_color="$RED"
                fi
                print_row "$t_name" "$t_status" "$t_color" "$t_display"
        else
                print_row "$t_full" "not cloned" "$RED"
        fi
        echo ""
        exit 0
fi

# --- One GitHub API call ---
if $SHOW_PRS; then
        pr_fields="pullRequests(states: OPEN) { totalCount }"
else
        pr_fields=""
fi
# Union two sources so org-native repos aren't missed:
#   1. viewer.repositories            - personal repos + repos you're a direct collaborator on
#   2. viewer.organizations[].repositories - every repo in every org you belong to
# (2) is required because repos created directly in an org, which you reach only via your
# org-owner/admin role, do NOT surface under viewer.repositories affiliations.
raw_json=$(gh api graphql -f query="
  { viewer {
    repositories(first: ${REPO_LIMIT}, orderBy: {field: PUSHED_AT, direction: DESC},
      affiliations: [OWNER, COLLABORATOR, ORGANIZATION_MEMBER]) {
      nodes { name nameWithOwner isPrivate owner { __typename } pushedAt ${pr_fields} }
    }
    organizations(first: 25) {
      nodes {
        repositories(first: ${REPO_LIMIT}, orderBy: {field: PUSHED_AT, direction: DESC}) {
          nodes { name nameWithOwner isPrivate owner { __typename } pushedAt ${pr_fields} }
        }
      }
    }
  }}
" 2>/dev/null) || {
        echo "  Failed to reach GitHub. Run: gh auth login"
        exit 1
}

# Normalize back into the original shape (.data.viewer.repositories.nodes) so the rest of
# the script is untouched: merge both sources, drop null-push (empty repos), dedupe by full
# name, sort newest-pushed first.
repos_json=$(echo "$raw_json" | jq '
  ( [ .data.viewer.repositories.nodes[]? ]
    + [ .data.viewer.organizations.nodes[]?.repositories.nodes[]? ] )
  | map(select(.pushedAt != null))
  | unique_by(.nameWithOwner)
  | sort_by(.pushedAt) | reverse
  | { data: { viewer: { repositories: { nodes: . } } } }
')

# name -> "<ownerType>\t<isPrivate>" so print_row can pick a glyph per repo.
meta_lookup=$(echo "$repos_json" | jq -r '
    .data.viewer.repositories.nodes[]
    | select(.pushedAt != null)
    | "\(.name)\t\(.owner.__typename)\t\(.isPrivate)"
' 2>/dev/null)

# --- Determine cutoff and header based on mode ---
active_repos=()
today=$(date +%Y-%m-%d)
cutoff=""
header=""

if yesterday=$(date -v-1d +%Y-%m-%d 2>/dev/null); then
