jq_args=()
jq_filter='.'
if [ -n "$cutoff" ]; then
        if cutoff_epoch=$(date -jf "%Y-%m-%dT%H:%M:%S" "$cutoff" +%s 2>/dev/null); then
                cutoff_utc=$(date -u -r "$cutoff_epoch" +"%Y-%m-%dT%H:%M:%SZ")
        elif cutoff_epoch=$(date -d "$cutoff" +%s 2>/dev/null); then
                cutoff_utc=$(date -u -d "@$cutoff_epoch" +"%Y-%m-%dT%H:%M:%SZ")
        else
