fi

# --- Filter repos by --before ---
if [ -n "$BEFORE_ARG" ]; then
        before_ts="$BEFORE_ARG"
        case "$before_ts" in ????-??-??) before_ts="${before_ts}T23:59:59" ;; esac
        if before_epoch=$(date -jf "%Y-%m-%dT%H:%M:%S" "$before_ts" +%s 2>/dev/null); then
                before_utc=$(date -u -r "$before_epoch" +"%Y-%m-%dT%H:%M:%SZ")
        elif before_epoch=$(date -d "$before_ts" +%s 2>/dev/null); then
                before_utc=$(date -u -d "@$before_epoch" +"%Y-%m-%dT%H:%M:%SZ")
        else
