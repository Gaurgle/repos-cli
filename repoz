#!/usr/bin/env bash
set -eo pipefail

REPO_DIR="${REPO_CHECK_DIR:-$(pwd)}"
CONFIG_FILE="${XDG_CONFIG_HOME:-$HOME/.config}/repoz/config"

# --- Defaults (overridden by config file) ---
WORK_START=9
WORK_END=18
REPO_LIMIT=50
EXTRA_DIRS=()
TERM_W=$(stty size </dev/tty 2>/dev/null | awk '{print $2}') || true
: "${TERM_W:=${COLUMNS:-0}}"
(( TERM_W < 40 )) && TERM_W=$(tput cols 2>/dev/null || echo 80)
(( TERM_W < 40 )) && TERM_W=80

# --- Load config ---
if [ -f "$CONFIG_FILE" ]; then
    while IFS='=' read -r key val; do
        case "$key" in
            \#*|"") continue ;;
            WORK_START)  WORK_START=$((10#$val)) ;;
            WORK_END)    WORK_END=$((10#$val)) ;;
            REPO_LIMIT)  REPO_LIMIT=$((10#$val)) ;;
            REPO_CHECK_DIR) [ -z "${REPO_CHECK_DIR:-}" ] && REPO_DIR="$val" ;;
            EXTRA_DIRS) IFS=':' read -ra EXTRA_DIRS <<< "$val" ;;
        esac
    done < "$CONFIG_FILE"
fi

# Build validated scan dirs (REPO_DIR + existing EXTRA_DIRS)
SCAN_DIRS=("$REPO_DIR")
for _d in "${EXTRA_DIRS[@]}"; do
    [ -d "$_d" ] && SCAN_DIRS+=("$_d")
done

# If cwd sits inside a git repo, include that repo's toplevel so the
# dirty-scan pass catches it when running from a subdirectory.
_toplevel=$(git -C "$REPO_DIR" rev-parse --show-toplevel 2>/dev/null)
[ -n "$_toplevel" ] && [ "$_toplevel" != "$REPO_DIR" ] && SCAN_DIRS+=("$_toplevel")

# Catppuccin Mocha palette (printf for bash 3.2 compat)
PEACH=$(printf '\033[38;2;250;179;135m')    # behind / warning
GREEN=$(printf '\033[38;2;166;227;161m')    # ahead / synced
YELLOW=$(printf '\033[38;2;249;226;175m')   # uncommitted
SAPPHIRE=$(printf '\033[38;2;116;199;236m') # repo names
LAVENDER=$(printf '\033[38;2;180;190;254m') # header
MAUVE=$(printf '\033[38;2;203;166;247m')    # section labels
HASH_COLOR=$(printf '\033[38;2;140;155;180m') # commit hashes (muted blue-gray)
DIFF_ADD=$(printf '\033[38;2;134;194;134m') # diff +N (mellow green)
DIFF_DEL=$(printf '\033[38;2;210;140;140m') # diff -N (mellow red)
OVERLAY=$(printf '\033[38;2;127;132;156m')  # paths, subtle text
SURFACE=$(printf '\033[38;2;69;71;90m')     # dots, dividers
BOLD=$(printf '\033[1m')
RESET=$(printf '\033[0m')

# --- Slot labels from config ---
slot_label_work="Work ($(printf '%02d' $WORK_START)-$(printf '%02d' $WORK_END))"
slot_label_evening="Evening ($(printf '%02d' $WORK_END)-00)"

usage() {
    cat <<'EOF'
Usage: repoz [options]

Checks GitHub for recently pushed repos and compares with local state.
Only checks repos found under the current directory (or REPO_CHECK_DIR).

Modes (pick one):
  (default)       Show activity since the previous time slot
  --since DATE    Show all activity since DATE (e.g. 2026-03-15)
  --since yesterday  Relative: yesterday
  --since 3d      Relative: 3 days ago
  --since 1w      Relative: 1 week ago
  -t, --today     Show all activity since midnight
  -a, --all       Show all divergence (no time filter)
  -d, --dirty     Local only — show uncommitted/untracked/unpushed (no GitHub)

Options:
  --author NAME   Filter displayed commits by author (partial match)
  --before DATE   Only show repos pushed before DATE (same formats as --since)
  -s, --stat      Show diff stats per commit (+lines/-lines)
  -p, --prs       Also show open pull requests for each repo
  -h, --help      Show this help

Time slots: Work (09–18), Evening (18–00). Default mode shows activity
since the previous slot boundary, so you see what changed while away.
Config: ~/.config/repoz/config (or REPO_CHECK_DIR env var).
Set EXTRA_DIRS=/path/one:/path/two to scan additional directories.
EOF
}

# --- Parse args ---
MODE="auto"
SINCE_ARG=""
BEFORE_ARG=""
AUTHOR_FILTER=""
SHOW_PRS=false
SHOW_STAT=false

while [ $# -gt 0 ]; do
    case "$1" in
        --since)  MODE="since"; SINCE_ARG="$2"; shift 2 ;;
        --before) BEFORE_ARG="$2"; shift 2 ;;
        --author) AUTHOR_FILTER="$2"; shift 2 ;;
        -t|--today)  MODE="today"; shift ;;
        -a|--all)    MODE="all"; shift ;;
        -d|--dirty)  MODE="dirty"; shift ;;
        -s|--stat)   SHOW_STAT=true; shift ;;
        -p|--prs)    SHOW_PRS=true; shift ;;
        -h|--help) usage; exit 0 ;;
        *) echo "Unknown: $1"; usage; exit 1 ;;
    esac
done

# --- Resolve relative dates for --since ---
if [ "$MODE" = "since" ] && [ -n "$SINCE_ARG" ]; then
    case "$SINCE_ARG" in
        yesterday)
            if SINCE_ARG=$(date -v-1d +%Y-%m-%d 2>/dev/null); then :
            else SINCE_ARG=$(date -d "yesterday" +%Y-%m-%d); fi
            ;;
        *d)
            days="${SINCE_ARG%d}"
            if SINCE_ARG=$(date -v-${days}d +%Y-%m-%d 2>/dev/null); then :
            else SINCE_ARG=$(date -d "${days} days ago" +%Y-%m-%d); fi
            ;;
        *w)
            weeks="${SINCE_ARG%w}"
            days=$(( weeks * 7 ))
            if SINCE_ARG=$(date -v-${days}d +%Y-%m-%d 2>/dev/null); then :
            else SINCE_ARG=$(date -d "${days} days ago" +%Y-%m-%d); fi
            ;;
    esac
fi

# --- Resolve relative dates for --before ---
if [ -n "$BEFORE_ARG" ]; then
    case "$BEFORE_ARG" in
        yesterday)
            if BEFORE_ARG=$(date -v-1d +%Y-%m-%d 2>/dev/null); then :
            else BEFORE_ARG=$(date -d "yesterday" +%Y-%m-%d); fi
            ;;
        *d)
            days="${BEFORE_ARG%d}"
            if BEFORE_ARG=$(date -v-${days}d +%Y-%m-%d 2>/dev/null); then :
            else BEFORE_ARG=$(date -d "${days} days ago" +%Y-%m-%d); fi
            ;;
        *w)
            weeks="${BEFORE_ARG%w}"
            days=$(( weeks * 7 ))
            if BEFORE_ARG=$(date -v-${days}d +%Y-%m-%d 2>/dev/null); then :
            else BEFORE_ARG=$(date -d "${days} days ago" +%Y-%m-%d); fi
            ;;
    esac
fi

DIV_W=$(( TERM_W - 4 ))
DIV="${SURFACE}$(printf '%*s' "$DIV_W" '' | tr ' ' '─')${RESET}"

section_div() {
    local label="$1"
    local prefix="── ${label} "
    local remain=$(( DIV_W - ${#prefix} ))
    printf '  %s── %s%s %s%s%s\n' \
        "$SURFACE" "$MAUVE" "$label" "$SURFACE" "$(printf '%*s' "$remain" '' | tr ' ' '─')" "$RESET"
}

W=$(( DIV_W - 4 ))

print_row() {
    local name="$1" status="$2" color="$3" path="${4:-}"
    local label="$name"
    [ -n "$path" ] && label="${name} ${OVERLAY}${path}${RESET}"
    local label_len=${#name}
    [ -n "$path" ] && label_len=$(( ${#name} + 1 + ${#path} ))
    local pad=$(( W - label_len - ${#status} ))
    (( pad < 3 )) && pad=3
    local dots=$(printf '%*s' "$pad" '' | tr ' ' '·')
    printf "    ${SAPPHIRE}%s${RESET}" "$name"
    [ -n "$path" ] && printf " ${OVERLAY}%s${RESET}" "$path"
    printf " ${SURFACE}%s${RESET} %s%s${RESET}\n" "$dots" "$color" "$status"
}

# --- Dirty mode: local only, no GitHub ---
if [ "$MODE" = "dirty" ]; then
    echo ""
    echo "  ${LAVENDER}${BOLD}repoz${RESET} ${OVERLAY}— local changes${RESET}"
    echo "  ${DIV}"
    echo ""

    count_unpushed() {
        local repo_path="$1" total=0
        while IFS= read -r branch; do
            [ -z "$branch" ] && continue
            local upstream
            upstream=$(git -C "$repo_path" rev-parse --abbrev-ref \
                "${branch}@{upstream}" 2>/dev/null) || continue
            local a
            a=$(git -C "$repo_path" rev-list --count \
                "${upstream}..${branch}" 2>/dev/null || echo 0)
            total=$(( total + a ))
        done < <(git -C "$repo_path" for-each-ref \
            --format='%(refname:short)' refs/heads/ 2>/dev/null)
        echo "$total"
    }

    dirty_count=0
    while IFS= read -r gitdir; do
        repo_path="${gitdir%/.git}"
        name=$(basename "$repo_path")
        display="~${repo_path#$HOME}"

        changed=$(git -C "$repo_path" status --porcelain 2>/dev/null \
            | wc -l | tr -d ' ')
        local_ahead=$(count_unpushed "$repo_path")

        [ "$changed" -eq 0 ] && [ "$local_ahead" -eq 0 ] && continue

        if [ "$local_ahead" -gt 0 ] && [ "$changed" -gt 0 ]; then
            print_row "$name" "${local_ahead} ahead, ${changed} uncommitted" "$YELLOW" "$display"
        elif [ "$local_ahead" -gt 0 ]; then
            print_row "$name" "${local_ahead} ahead" "$PEACH" "$display"
        else
            print_row "$name" "${changed} uncommitted" "$YELLOW" "$display"
        fi
        dirty_count=$(( dirty_count + 1 ))

    done < <(find "${SCAN_DIRS[@]}" -maxdepth 4 -name ".git" -type d 2>/dev/null | sort -u)

    echo ""
    echo "  ${DIV}"
    if [ "$dirty_count" -eq 0 ]; then
        echo "  ${GREEN}All clean.${RESET}"
    else
        echo "  ${YELLOW}${dirty_count} dirty${RESET}"
    fi
    echo ""
    exit 0
fi

# --- One GitHub API call ---
if $SHOW_PRS; then
    pr_fields="pullRequests(states: OPEN) { totalCount }"
else
    pr_fields=""
fi
repos_json=$(gh api graphql -f query="
  { viewer {
    repositories(first: ${REPO_LIMIT}, orderBy: {field: PUSHED_AT, direction: DESC},
      affiliations: [OWNER, COLLABORATOR, ORGANIZATION_MEMBER]) {
      nodes { name, pushedAt ${pr_fields} }
    }
  }}
" 2>/dev/null) || { echo "  Failed to reach GitHub. Run: gh auth login"; exit 1; }

# --- Determine cutoff and header based on mode ---
active_repos=()
today=$(date +%Y-%m-%d)
cutoff=""
header=""

if yesterday=$(date -v-1d +%Y-%m-%d 2>/dev/null); then :
else yesterday=$(date -d yesterday +%Y-%m-%d); fi

case "$MODE" in
    auto)
        # Find the latest date with any push activity from the API data,
        # rather than assuming "yesterday evening". Handles weekends/days off.
        latest_date=$(echo "$repos_json" | jq -r '
          [ .data.viewer.repositories.nodes[]
            | select(.pushedAt != null)
            | (.pushedAt | split("T")[0])
          ] | sort | last // empty
        ')
        if [ -n "$latest_date" ]; then
            cutoff="${latest_date}T00:00:00"
            header="${latest_date}"
        else
            cutoff="${yesterday}T$(printf '%02d' $WORK_END):00:00"
            header="since ${yesterday}  ${slot_label_evening}"
        fi
        ;;
    since)
        cutoff="$SINCE_ARG"
        case "$cutoff" in ????-??-??) cutoff="${cutoff}T00:00:00" ;; esac
        header="since $SINCE_ARG"
        ;;
    today)
        cutoff="${today}T00:00:00"
        header="today"
        ;;
    all)
        header="all divergence"
        ;;
esac

# --- Filter repos by cutoff ---
jq_args=()
jq_filter='.'
if [ -n "$cutoff" ]; then
    if cutoff_epoch=$(date -jf "%Y-%m-%dT%H:%M:%S" "$cutoff" +%s 2>/dev/null); then
        cutoff_utc=$(date -u -r "$cutoff_epoch" +"%Y-%m-%dT%H:%M:%SZ")
    elif cutoff_epoch=$(date -d "$cutoff" +%s 2>/dev/null); then
        cutoff_utc=$(date -u -d "@$cutoff_epoch" +"%Y-%m-%dT%H:%M:%SZ")
    else
        cutoff_utc="${cutoff}Z"
    fi
    jq_args=(--arg c "$cutoff_utc")
    jq_filter='select(.pushedAt > $c)'
fi

# --- Filter repos by --before ---
if [ -n "$BEFORE_ARG" ]; then
    before_ts="$BEFORE_ARG"
    case "$before_ts" in ????-??-??) before_ts="${before_ts}T23:59:59" ;; esac
    if before_epoch=$(date -jf "%Y-%m-%dT%H:%M:%S" "$before_ts" +%s 2>/dev/null); then
        before_utc=$(date -u -r "$before_epoch" +"%Y-%m-%dT%H:%M:%SZ")
    elif before_epoch=$(date -d "$before_ts" +%s 2>/dev/null); then
        before_utc=$(date -u -d "@$before_epoch" +"%Y-%m-%dT%H:%M:%SZ")
    else
        before_utc="${before_ts}Z"
    fi
    jq_args+=(--arg b "$before_utc")
    jq_filter="${jq_filter} | select(.pushedAt < \$b)"
    header="${header} → before ${BEFORE_ARG}"
fi

# --- Append author to header ---
[ -n "$AUTHOR_FILTER" ] && header="${header} (author: ${AUTHOR_FILTER})"

while IFS= read -r name; do
    [ -n "$name" ] && active_repos+=("$name")
done < <(echo "$repos_json" | jq -r "${jq_args[@]}" "
    .data.viewer.repositories.nodes[]
    | select(.pushedAt != null)
    | ${jq_filter}
    | .name
")

# Build PR count lookup when --prs is enabled (newline-separated "name\tcount")
pr_lookup=""
open_prs_total=0
if $SHOW_PRS; then
    pr_lookup=$(echo "$repos_json" | jq -r '
        .data.viewer.repositories.nodes[]
        | select(.pullRequests != null)
        | select(.pullRequests.totalCount > 0)
        | "\(.name)\t\(.pullRequests.totalCount)"
    ' 2>/dev/null)
fi

# Lookup helper: get_pr_count <repo_name>
get_pr_count() {
    echo "$pr_lookup" | awk -F'\t' -v name="$1" '$1 == name { print $2; exit }'
}

echo ""
echo "  ${LAVENDER}${BOLD}repoz${RESET} ${OVERLAY}— ${header}${RESET}"
echo "  ${DIV}"

if [ ${#active_repos[@]} -eq 0 ]; then
    echo ""
    echo "  ${GREEN}No GitHub activity.${RESET}"
fi
echo ""

# --- Check active repos locally ---
needs_pull=0
has_unpushed=0
not_local=0
synced=0
dirty_count=0

# Print a single commit line with author and optional diff-stat
print_commit_line() {
    local hash="$1" author="$2" message="$3" ins="$4" del="$5"

    # Build right side (plain text for width calc)
    local stat=""
    if [ "$ins" -gt 0 ] || [ "$del" -gt 0 ]; then
        [ "$ins" -gt 0 ] && stat="+${ins}"
        if [ "$del" -gt 0 ]; then
            [ -n "$stat" ] && stat="${stat} "
            stat="${stat}-${del}"
        fi
    fi
    local right=""
    [ -n "$stat" ] && right="${stat}  "
    right="${right}${author}"
    local right_len=${#right}

    # Available width: 6 indent + 3 format spaces + 1 right margin = 10
    local avail=$(( TERM_W - 10 ))
    local left="${hash} ${message}"
    local max_left=$(( avail - right_len - 3 ))

    # Truncate message if needed
    if (( ${#left} > max_left )) && (( max_left > 10 )); then
        left="${left:0:$(( max_left - 1 ))}.."
    fi

    local pad=$(( avail - ${#left} - right_len ))
    (( pad < 2 )) && pad=2
    local dots=$(printf '%*s' "$pad" '' | tr ' ' '·')

    # Colorize: stat then author
    local colored_right=""
    if [ -n "$stat" ]; then
        local cs=""
        [ "$ins" -gt 0 ] && cs="${DIFF_ADD}+${ins}${RESET}"
        if [ "$del" -gt 0 ]; then
            [ -n "$cs" ] && cs="${cs} "
            cs="${cs}${DIFF_DEL}-${del}${RESET}"
        fi
        colored_right="${cs}  "
    fi
    colored_right="${colored_right}${OVERLAY}${author}${RESET}"

    printf "      ${HASH_COLOR}%s${RESET} %s ${SURFACE}%s${RESET} %s\n" \
        "$hash" "${left#* }" "$dots" "$colored_right"
}

# Print commits for a range, with author filtering and stat
print_commits() {
    local local_path="$1" range="$2" with_stat="${3:-false}"
    local author_flag=""
    [ -n "$AUTHOR_FILTER" ] && author_flag="--author=$AUTHOR_FILTER"

    local output=""
    if [ "$with_stat" = "true" ]; then
        output=$(git -C "$local_path" log $author_flag \
            --format="COMMIT|%h|%aN|%s" --shortstat "$range" 2>/dev/null) || true
    else
        output=$(git -C "$local_path" log $author_flag \
            --format="COMMIT|%h|%aN|%s" "$range" 2>/dev/null) || true
    fi

    [ -z "$output" ] && return

    local hash="" author="" message="" pending=false
    while IFS= read -r line; do
        if [[ "$line" == COMMIT\|* ]]; then
            # Print previous pending commit (had no stat line)
            $pending && print_commit_line "$hash" "$author" "$message" 0 0
            IFS='|' read -r _ hash author message <<< "$line"
            pending=true
        elif [[ "$line" =~ "changed" ]] && $pending; then
            local ins=0 del=0
            ins=$(echo "$line" | grep -oE '[0-9]+ insertion' | grep -oE '[0-9]+') || ins=0
            del=$(echo "$line" | grep -oE '[0-9]+ deletion' | grep -oE '[0-9]+') || del=0
            [ -z "$ins" ] && ins=0
            [ -z "$del" ] && del=0
            print_commit_line "$hash" "$author" "$message" "$ins" "$del"
            pending=false
        fi
    done <<< "$output"
    # Print last pending commit
    ! $pending || print_commit_line "$hash" "$author" "$message" 0 0
}

# Checks a repo: compare branches, print row + commits
check_repo() {
    local name="$1" local_path="$2" skip_fetch="${3:-false}"
    local display="~${local_path#$HOME}"

    if ! $skip_fetch; then
        git -C "$local_path" fetch --quiet 2>/dev/null || true
    fi

    local behind=0 ahead=0
    # Collect branch pairs for commit listing
    local branches_info=""
    while IFS= read -r branch; do
        [ -z "$branch" ] && continue
        local upstream
        upstream=$(git -C "$local_path" rev-parse --abbrev-ref \
            "${branch}@{upstream}" 2>/dev/null) || continue
        local b a
        b=$(git -C "$local_path" rev-list --count \
            "${branch}..${upstream}" 2>/dev/null || echo 0)
        a=$(git -C "$local_path" rev-list --count \
            "${upstream}..${branch}" 2>/dev/null || echo 0)
        behind=$(( behind + b ))
        ahead=$(( ahead + a ))
        if [ "$b" -gt 0 ] || [ "$a" -gt 0 ]; then
            branches_info="${branches_info}${branch}|${upstream}|${b}|${a} "
        fi
    done < <(git -C "$local_path" for-each-ref \
        --format='%(refname:short)' refs/heads/ 2>/dev/null)

    # Check for uncommitted/untracked changes
    local dirty
    dirty=$(git -C "$local_path" status --porcelain 2>/dev/null | wc -l | tr -d ' ')

    local status_parts=""
    if (( behind > 0 )); then
        status_parts="${behind} behind"
        needs_pull=$(( needs_pull + 1 ))
    fi
    if (( ahead > 0 )); then
        [ -n "$status_parts" ] && status_parts="${status_parts}, "
        status_parts="${status_parts}${ahead} ahead"
        has_unpushed=$(( has_unpushed + 1 ))
    fi
    if (( dirty > 0 )); then
        [ -n "$status_parts" ] && status_parts="${status_parts}, "
        status_parts="${status_parts}${dirty} uncommitted"
        dirty_count=$(( dirty_count + 1 ))
    fi

    # Append PR count if --prs and repo has open PRs
    local pr_text=""
    if $SHOW_PRS; then
        local pc
        pc=$(get_pr_count "$name")
        pc="${pc:-0}"
        if (( pc > 0 )); then
            [ -n "$status_parts" ] && status_parts="${status_parts}, "
            status_parts="${status_parts}${pc} PR"
            (( pc > 1 )) && status_parts="${status_parts}s"
            open_prs_total=$(( open_prs_total + pc ))
        fi
    fi

    # Determine if repo has divergence
    local has_changes=false
    if [ -n "$status_parts" ]; then
        local color="$PEACH"
        (( dirty > 0 )) && color="$YELLOW"
        print_row "$name" "$status_parts" "$color" "$display"
        has_changes=true
    else
        print_row "$name" "synced" "$GREEN" "$display"
        synced=$(( synced + 1 ))
    fi

    # Show stat if repo has changes or -s flag is set
    local show_stat_here=false
    { $has_changes || $SHOW_STAT; } && show_stat_here=true

    # Print commits
    if [ -n "$branches_info" ]; then
        for info in $branches_info; do
            local br="${info%%|*}"; local rest="${info#*|}"
            local up="${rest%%|*}"; rest="${rest#*|}"
            local b="${rest%%|*}"; local a="${rest#*|}"
            [ "$b" -gt 0 ] && print_commits "$local_path" "${br}..${up}" "$show_stat_here"
            [ "$a" -gt 0 ] && print_commits "$local_path" "${up}..${br}" "$show_stat_here"
        done
    else
        print_commits "$local_path" "-1" "$show_stat_here"
    fi
}

# Track which repo paths have been shown
checked_paths=""

# Disable set -e for repo processing (git commands may fail on edge-case repos)
set +e

# --- Pass 1: repos under REPO_DIR (with parallel fetch) ---
elsewhere_repos=()
pass1_names=()
pass1_paths=()
fetch_pids=()

for name in "${active_repos[@]}"; do
    local_path=$(find "$REPO_DIR" -maxdepth 3 -type d \( -iname "$name" -o -iname ".$name" \) \
        -exec test -d "{}/.git" \; -print -quit 2>/dev/null)

    if [ -z "$local_path" ]; then
        for _edir in "${EXTRA_DIRS[@]}"; do
            [ -d "$_edir" ] || continue
            local_path=$(find "$_edir" -maxdepth 3 -type d \( -iname "$name" -o -iname ".$name" \) \
                -exec test -d "{}/.git" \; -print -quit 2>/dev/null)
            [ -n "$local_path" ] && break
        done
    fi

    if [ -z "$local_path" ]; then
        elsewhere_repos+=("$name")
        continue
    fi

    pass1_names+=("$name")
    pass1_paths+=("$local_path")
    git -C "$local_path" fetch --quiet 2>/dev/null &
    fetch_pids+=($!)
done

# Wait for all pass 1 fetches
for pid in "${fetch_pids[@]}"; do
    wait "$pid" 2>/dev/null
done

# Display pass 1 repos (fetch already done)
for i in "${!pass1_names[@]}"; do
    check_repo "${pass1_names[$i]}" "${pass1_paths[$i]}" true
    checked_paths="${checked_paths}|${pass1_paths[$i]}"
done

# --- Pass 2: repos found elsewhere on the machine ---
if [ ${#elsewhere_repos[@]} -gt 0 ]; then
    # One scan of HOME for all git repos (instead of one find per repo)
    home_git_dirs=$(find "$HOME" -maxdepth 4 -type d \
        -not -path "*/Library/*" \
        -not -path "*/.Trash/*" \
        -not -path "*/node_modules/*" \
        -not -path "*/.cache/*" \
        -name ".git" 2>/dev/null)

    # Start parallel fetches for found elsewhere repos
    elsewhere_found_names=()
    elsewhere_found_paths=()
    elsewhere_fetch_pids=()

    for name in "${elsewhere_repos[@]}"; do
        local_path=""
        lc_name=$(echo "$name" | tr '[:upper:]' '[:lower:]')
        while IFS= read -r gitdir; do
            [ -z "$gitdir" ] && continue
            dir="${gitdir%/.git}"
            bname=$(basename "$dir")
            lc_bname=$(echo "$bname" | tr '[:upper:]' '[:lower:]')
            if [ "$lc_bname" = "$lc_name" ] || [ "$lc_bname" = ".$lc_name" ]; then
                local_path="$dir"
                break
            fi
        done <<< "$home_git_dirs"

        # Skip if already shown in pass 1
        case "$checked_paths" in *"|${local_path}"*) continue ;; esac

        elsewhere_found_names+=("$name")
        elsewhere_found_paths+=("${local_path:-}")

        if [ -n "$local_path" ]; then
            git -C "$local_path" fetch --quiet 2>/dev/null &
            elsewhere_fetch_pids+=($!)
        fi
    done

    # Wait for all elsewhere fetches
    for pid in "${elsewhere_fetch_pids[@]}"; do
        wait "$pid" 2>/dev/null
    done

    # Display elsewhere repos
    found_elsewhere=false
    for i in "${!elsewhere_found_names[@]}"; do
        name="${elsewhere_found_names[$i]}"
        local_path="${elsewhere_found_paths[$i]}"

        if ! $found_elsewhere; then
            echo ""
            section_div "also active"
            echo ""
            found_elsewhere=true
        fi

        if [ -n "$local_path" ]; then
            check_repo "$name" "$local_path" true
            checked_paths="${checked_paths}|${local_path}"
        else
            nc_status="not cloned"
            if $SHOW_PRS; then
                pc=$(get_pr_count "$name")
                pc="${pc:-0}"
                if (( pc > 0 )); then
                    nc_status="not cloned, ${pc} PR"
                    (( pc > 1 )) && nc_status="${nc_status}s"
                    open_prs_total=$(( open_prs_total + pc ))
                fi
            fi
            print_row "$name" "$nc_status" "$OVERLAY"
            not_local=$(( not_local + 1 ))
        fi
    done
fi

# --- Pass 3: local repos with uncommitted or unpushed changes ---
has_local_changes=false

count_unpushed() {
    local repo_path="$1" total=0
    while IFS= read -r branch; do
        [ -z "$branch" ] && continue
        local upstream
        upstream=$(git -C "$repo_path" rev-parse --abbrev-ref \
            "${branch}@{upstream}" 2>/dev/null) || continue
        local a
        a=$(git -C "$repo_path" rev-list --count \
            "${upstream}..${branch}" 2>/dev/null || echo 0)
        total=$(( total + a ))
    done < <(git -C "$repo_path" for-each-ref \
        --format='%(refname:short)' refs/heads/ 2>/dev/null)
    echo "$total"
}

while IFS= read -r gitdir; do
    repo_path="${gitdir%/.git}"

    # Skip repos already shown
    case "$checked_paths" in *"|${repo_path}"*) continue ;; esac

    name=$(basename "$repo_path")
    display="~${repo_path#$HOME}"

    changed=$(git -C "$repo_path" status --porcelain 2>/dev/null \
        | wc -l | tr -d ' ')
    local_ahead=$(count_unpushed "$repo_path")

    [ "$changed" -eq 0 ] && [ "$local_ahead" -eq 0 ] && continue

    if ! $has_local_changes; then
        echo ""
        section_div "local changes"
        echo ""
        has_local_changes=true
    fi

    if [ "$local_ahead" -gt 0 ] && [ "$changed" -gt 0 ]; then
        print_row "$name" "${local_ahead} ahead, ${changed} uncommitted" "$YELLOW" "$display"
    elif [ "$local_ahead" -gt 0 ]; then
        print_row "$name" "${local_ahead} ahead" "$PEACH" "$display"
    else
        print_row "$name" "${changed} uncommitted" "$YELLOW" "$display"
    fi
    dirty_count=$(( dirty_count + 1 ))

done < <(find "${SCAN_DIRS[@]}" -maxdepth 4 -name ".git" -type d 2>/dev/null | sort -u)

# --- Summary ---
echo ""
echo "  ${DIV}"
parts=""
[ $needs_pull -gt 0 ]   && parts="${parts}${PEACH}${needs_pull} behind${RESET} ${SURFACE}·${RESET} "
[ $has_unpushed -gt 0 ] && parts="${parts}${PEACH}${has_unpushed} ahead${RESET} ${SURFACE}·${RESET} "
[ $dirty_count -gt 0 ]   && parts="${parts}${YELLOW}${dirty_count} uncommitted${RESET} ${SURFACE}·${RESET} "
[ $synced -gt 0 ]        && parts="${parts}${GREEN}${synced} synced${RESET} ${SURFACE}·${RESET} "
[ $not_local -gt 0 ]     && parts="${parts}${OVERLAY}${not_local} not local${RESET} ${SURFACE}·${RESET} "
$SHOW_PRS && [ $open_prs_total -gt 0 ] && parts="${parts}${MAUVE}${open_prs_total} open PRs${RESET} ${SURFACE}·${RESET} "
parts="${parts% ${SURFACE}·${RESET} }"
echo "  ${parts}"
echo ""
